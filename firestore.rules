rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('activeProgramId' in data) || (data.activeProgramId is string && data.activeProgramId.size() <= 128));
    }

    function isValidStationProgram(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'programData', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 128
        && data.programData is string && data.programData.size() <= 500000
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1024));
    }

    function isValidChatConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt', 'messages'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.messages is list && data.messages.size() <= 200;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile document
    match /users/{userId} {
      allow get, delete: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;

      // User saved ECS Workbench Studio station programs
      match /programs/{programId} {
        allow get, delete: if isOwner(userId) && isValidId(userId) && isValidId(programId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(programId) && isValidStationProgram(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(programId) && isValidStationProgram(incoming()) && incoming().userId == existing().userId;
      }

      // User saved AI chat conversations
      match /chatConversations/{convId} {
        allow get, delete: if isOwner(userId) && isValidId(userId) && isValidId(convId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(convId) && isValidChatConversation(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(convId) && isValidChatConversation(incoming()) && incoming().userId == existing().userId;
      }
    }
  }
}
